<Window x:Class="Proyecto_MySQL_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_MySQL_1"
        mc:Ignorable="d"
        Title="Consulta Alquileres por Empleado" Height="250" Width="400">
	<Grid Margin="20">
		<StackPanel VerticalAlignment="Center">
			<Label Content="Seleccione Empleado (Staff):" FontWeight="Bold"/>
			<ComboBox x:Name="cmbEmpleados"
                      SelectionChanged="cmbEmpleados_SelectionChanged"
                      Margin="0,0,0,15" Height="30"/>

			<Label Content="Total de Alquileres Realizados:" FontWeight="Bold"/>
			<TextBox x:Name="txtTotalAlquileres"
                     IsReadOnly="True"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Padding="5,0,0,0"/>
		</StackPanel>
	</Grid>
</Window>